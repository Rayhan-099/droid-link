+pub struct BitrateController {
+    current_kbps: u32,
+    min_kbps: u32,
+    max_kbps: u32,
+    last_adjustment: Instant,
+    cooldown: Duration,
+}
+
+impl BitrateController {
+    pub fn new(initial_kbps: u32) -> Self {
+        Self {
+            current_kbps: initial_kbps,
+            min_kbps: 5_000,
+            max_kbps: 30_000,
+            last_adjustment: Instant::now(),
+            cooldown: Duration::from_secs(5),
+        }
+    }
+
+    pub fn evaluate(&mut self, median_rtt: Duration) -> Option<u32> {
+        let now = Instant::now();
+        if now.duration_since(self.last_adjustment) < self.cooldown {
+            return None;
+        }
+
+        let ms = median_rtt.as_secs_f64() * 1000.0;
+        if ms > 45.0 && self.current_kbps > self.min_kbps {
+            let new_kbps = ((self.current_kbps as f64 * 0.8) as u32).max(self.min_kbps);
+            if new_kbps != self.current_kbps {
+                self.current_kbps = new_kbps;
+                self.last_adjustment = now;
+                tracing::info!("Adaptive bitrate reduced to {new_kbps} kbps (median RTT: {ms:.1} ms)");
+                return Some(new_kbps);
+            }
+        } else if ms < 25.0 && self.current_kbps < self.max_kbps {
+            let new_kbps = ((self.current_kbps as f64 * 1.1) as u32).min(self.max_kbps);
+            if new_kbps != self.current_kbps {
+                self.current_kbps = new_kbps;
+                self.last_adjustment = now;
+                tracing::info!("Adaptive bitrate increased to {new_kbps} kbps (median RTT: {ms:.1} ms)");
+                return Some(new_kbps);
+            }
+        }
+        None
+    }
+}
+
+fn median_duration(durations: &[Duration]) -> Option<Duration> {
+    if durations.is_empty() {
+        return None;
+    }
+    let mut sorted = durations.to_vec();
+    sorted.sort_unstable();
+    Some(sorted[sorted.len() / 2])
+}
