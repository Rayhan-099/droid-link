#!/usr/bin/env bash
# DroidLink — Background Disconnect Watchdog
# Author: Rayhan Khan (https://github.com/Rayhan-099)
# License: MIT

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/droidlink-device"

TABLET_AUDIO="${SCRIPT_DIR}/tablet-audio"
if [[ ! -x "${TABLET_AUDIO}" ]]; then
    TABLET_AUDIO="$(command -v tablet-audio || echo "")"
fi

TARGET_DEVICE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--device)
            TARGET_DEVICE="${2:-}"
            shift 2
            ;;
        --device=*)
            TARGET_DEVICE="${1#*=}"
            shift
            ;;
        *)
            shift
            ;;
    esac
done

DEVICE_SERIAL="$(droidlink_resolve_device "${TARGET_DEVICE}" 2>/dev/null || echo "${TARGET_DEVICE}")"
BASE_STATE_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/tablet"
if [[ -n "${DEVICE_SERIAL}" ]]; then
    STATE_DIR="${BASE_STATE_DIR}/${DEVICE_SERIAL}"
else
    STATE_DIR="${BASE_STATE_DIR}"
fi
mkdir -p "${STATE_DIR}"
LOG_FILE="${STATE_DIR}/watchdog.log"

echo "$(date -Iseconds): Watchdog started (PID $$) monitoring device ${DEVICE_SERIAL:-unknown}" >> "${LOG_FILE}"

consecutive_failures=0

while true; do
    sleep 2

    # If device was known, verify it remains connected
    if [[ -n "${DEVICE_SERIAL}" ]]; then
        if "${DROIDLINK_ADB}" devices 2>/dev/null | grep -E "^${DEVICE_SERIAL}\s+device" >/dev/null 2>&1; then
            consecutive_failures=0
        else
            consecutive_failures=$((consecutive_failures + 1))
            echo "$(date -Iseconds): Device ${DEVICE_SERIAL} not seen (count: ${consecutive_failures})" >> "${LOG_FILE}"
            if [[ "${consecutive_failures}" -ge 2 ]]; then
                echo "$(date -Iseconds): Device disconnected. Triggering audio stop & restore..." >> "${LOG_FILE}"
                if [[ -n "${TABLET_AUDIO}" && -x "${TABLET_AUDIO}" ]]; then
                    device_flag=()
                    if [[ -n "${DEVICE_SERIAL}" ]]; then
                        device_flag=("--device" "${DEVICE_SERIAL}")
                    fi
                    "${TABLET_AUDIO}" "${device_flag[@]}" stop >> "${LOG_FILE}" 2>&1 || true
                fi
                exit 0
            fi
        fi
    fi

    # Check if audio sink is still active; if not, watchdog exits cleanly
    if ! pactl list short sinks 2>/dev/null | grep -q "Tablet_Audio"; then
        echo "$(date -Iseconds): Tablet_Audio sink inactive. Watchdog exiting cleanly." >> "${LOG_FILE}"
        exit 0
    fi
done
