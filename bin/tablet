#!/usr/bin/env bash
# DroidLink — Unified CLI for Android Tablet Extended Display, Audio and Input on Linux
# Author: Rayhan Khan (https://github.com/Rayhan-099)
# License: MIT

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/droidlink-device"

TABLET_AUDIO="${SCRIPT_DIR}/tablet-audio"
if [[ ! -x "${TABLET_AUDIO}" ]]; then
    TABLET_AUDIO="$(command -v tablet-audio || echo "")"
fi

INPUT_DRIVER="${SCRIPT_DIR}/droidlink-input"
if [[ ! -x "${INPUT_DRIVER}" ]]; then
    INPUT_DRIVER="$(command -v droidlink-input || echo "")"
fi

# Flag parsing
TARGET_DEVICE=""
POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--device)
            TARGET_DEVICE="${2:-}"
            shift 2
            ;;
        --device=*)
            TARGET_DEVICE="${1#*=}"
            shift
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

set -- "${POSITIONAL_ARGS[@]:-start}"
ACTION="${1:-start}"

is_audio_active() {
    pactl list short sinks 2>/dev/null | grep -q "Tablet_Audio"
}

get_input_pid_file() {
    local dev="${1:-}"
    local state_dir="$(droidlink_get_device_state_dir "${dev}")"
    echo "${state_dir}/input.pid"
}

get_input_log_file() {
    local dev="${1:-}"
    local state_dir="$(droidlink_get_device_state_dir "${dev}")"
    echo "${state_dir}/input.log"
}

is_input_active() {
    local dev="${1:-}"
    local pid_file="$(get_input_pid_file "${dev}")"
    if [[ -f "${pid_file}" ]]; then
        local pid
        pid="$(cat "${pid_file}" 2>/dev/null || true)"
        if [[ -n "${pid}" ]] && ! kill -0 "${pid}" 2>/dev/null; then
            rm -f "${pid_file}"
        fi
    fi
    local default_pid_file="$(get_input_pid_file "default")"
    if [[ -f "${default_pid_file}" ]]; then
        local dpid="$(cat "${default_pid_file}" 2>/dev/null || true)"
        if [[ -n "${dpid}" ]] && ! kill -0 "${dpid}" 2>/dev/null; then
            rm -f "${default_pid_file}"
        fi
    fi
    if [[ -f "${XDG_CONFIG_HOME:-${HOME}/.config}/tablet/input.pid" ]]; then
        local lpid="$(cat "${XDG_CONFIG_HOME:-${HOME}/.config}/tablet/input.pid" 2>/dev/null || true)"
        if [[ -n "${lpid}" ]] && ! kill -0 "${lpid}" 2>/dev/null; then
            rm -f "${XDG_CONFIG_HOME:-${HOME}/.config}/tablet/input.pid"
        fi
    fi

    if systemctl --user is-active --quiet droidlink-input.service 2>/dev/null; then
        return 0
    fi
    if [[ -f "${pid_file}" ]]; then
        return 0
    fi
    if [[ -f "${XDG_CONFIG_HOME:-${HOME}/.config}/tablet/input.pid" ]]; then
        return 0
    fi
    pgrep -f "[d]roidlink-input" >/dev/null 2>&1
}

start_input_driver() {
    local dev="$1"
    if is_input_active "${dev}"; then
        return 0
    fi

    # Configure ADB reverse tunnel for touch input (port 4820)
    "${DROIDLINK_ADB}" -s "${dev}" reverse tcp:4820 tcp:4820 2>/dev/null || true

    # Try starting systemd service if installed
    if systemctl --user list-unit-files droidlink-input.service 2>/dev/null | grep -q "droidlink-input.service"; then
        echo "Starting DroidLink Wayland touch & stylus driver (systemd)..."
        systemctl --user start droidlink-input.service
        sleep 0.2
        if systemctl --user is-active --quiet droidlink-input.service; then
            return 0
        fi
    fi

    if [[ -x "${INPUT_DRIVER}" ]]; then
        local pid_file="$(get_input_pid_file "${dev}")"
        local log_file="$(get_input_log_file "${dev}")"
        mkdir -p "$(dirname "${pid_file}")"

        echo "Starting DroidLink Wayland touch & stylus driver..."
        # Launch input driver in background and log to state directory
        nohup "${INPUT_DRIVER}" --port 4820 > "${log_file}" 2>&1 < /dev/null &
        local pid=$!
        disown "${pid}" 2>/dev/null || true
        echo "${pid}" > "${pid_file}"

        sleep 0.2
        if ! kill -0 "${pid}" 2>/dev/null; then
            local reason
            reason="$(grep -m 1 "^Error:" "${log_file}" 2>/dev/null || head -n 1 "${log_file}" 2>/dev/null || echo "Exited unexpectedly")"
            rm -f "${pid_file}"
            echo "Error: Touch driver failed to start (${reason}). Run 'tablet doctor' for instructions." >&2
            return 1
        fi
        return 0
    else
        echo "Error: Input driver binary not found or not executable: ${INPUT_DRIVER}" >&2
        return 1
    fi
}

stop_input_driver() {
    local dev="${1:-}"
    if systemctl --user is-active --quiet droidlink-input.service 2>/dev/null; then
        systemctl --user stop droidlink-input.service 2>/dev/null || true
    fi
    local pid_file="$(get_input_pid_file "${dev}")"
    if [[ -f "${pid_file}" ]]; then
        local pid
        pid="$(cat "${pid_file}" 2>/dev/null || true)"
        if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
            kill "${pid}" 2>/dev/null || true
        fi
        rm -f "${pid_file}"
    fi
    rm -f "${XDG_CONFIG_HOME:-${HOME}/.config}/tablet/input.pid"
    pkill -f "[d]roidlink-input" 2>/dev/null || true
}


case "${ACTION}" in
  start)
    dev="$(droidlink_resolve_device "${TARGET_DEVICE}")"
    echo "Starting DroidLink extended display on device: ${dev}..."
    start_input_driver "${dev}" || true
    systemctl --user start moreland.service
    ;;

  devices)
    echo "=== Connected Android Devices ==="
    lines="$(droidlink_list_devices)"
    if [[ -z "${lines}" ]]; then
        echo "No Android devices connected over USB."
    else
        echo "${lines}"
    fi
    ;;

  input)
    subcmd="${2:-status}"
    case "${subcmd}" in
      start)
        dev="$(droidlink_resolve_device "${TARGET_DEVICE}")"
        if start_input_driver "${dev}"; then
            echo "Touch and stylus input driver active on device ${dev}."
        else
            echo "Failed to activate touch and stylus input driver on device ${dev}." >&2
            exit 1
        fi
        ;;
      stop)
        stop_input_driver "${TARGET_DEVICE:-}"
        echo "Touch and stylus input driver stopped."
        ;;
      status)
        dev="$(droidlink_resolve_device "${TARGET_DEVICE}" 2>/dev/null || echo "")"
        if is_input_active "${dev:-${TARGET_DEVICE:-}}"; then
            echo "Touch/Stylus driver: RUNNING (tcp:4820 forward active)"
        else
            log_file="$(get_input_log_file "${dev}")"
            if [[ ! -w "/dev/uinput" ]] && [[ ! -w "/dev/input/uinput" ]]; then
                echo "Touch/Stylus driver: INACTIVE (/dev/uinput restricted — run 'sudo ./scripts/setup-uinput.sh')"
            elif [[ -f "${log_file}" ]]; then
                last_err="$(grep -m 1 "^Error:" "${log_file}" 2>/dev/null || true)"
                if [[ -n "${last_err}" ]]; then
                    echo "Touch/Stylus driver: INACTIVE (${last_err})"
                else
                    echo "Touch/Stylus driver: INACTIVE"
                fi
            else
                echo "Touch/Stylus driver: INACTIVE"
            fi
        fi
        ;;
      *)
        echo "Usage: tablet input [start|stop|status]" >&2
        exit 1
        ;;
    esac
    ;;

  audio)
    if [[ -z "${TABLET_AUDIO}" || ! -x "${TABLET_AUDIO}" ]]; then
        echo "Error: tablet-audio helper script not found or not executable." >&2
        exit 1
    fi
    subcmd="${2:-start}"
    shift 2 || true
    device_flag=()
    if [[ -n "${TARGET_DEVICE}" ]]; then
        device_flag=("--device" "${TARGET_DEVICE}")
    fi
    "${TABLET_AUDIO}" "${device_flag[@]}" "${subcmd}" "$@"
    ;;

  stop)
    if is_audio_active; then
        echo "Stopping active tablet audio stream..."
        if [[ -n "${TABLET_AUDIO}" && -x "${TABLET_AUDIO}" ]]; then
            device_flag=()
            if [[ -n "${TARGET_DEVICE}" ]]; then
                device_flag=("--device" "${TARGET_DEVICE}")
            fi
            "${TABLET_AUDIO}" "${device_flag[@]}" stop || true
        fi
    fi
    echo "Stopping touch input driver..."
    stop_input_driver "${TARGET_DEVICE:-}"
    systemctl --user stop moreland.service
    ;;

  status)
    echo "=== Moreland Display Service ==="
    systemctl --user status moreland.service --no-pager || true
    echo ""
    echo "=== Tablet USB Connection ==="
    dev="$(droidlink_resolve_device "${TARGET_DEVICE}" 2>/dev/null || echo "")"
    if [[ -n "${dev}" ]]; then
        echo "Device: ${dev} (AUTHORIZED & CONNECTED)"
        if "${DROIDLINK_ADB}" -s "${dev}" shell pm list packages 2>/dev/null | grep -q "io.github.rayhan099.droidlink.display"; then
            echo "Display App: io.github.rayhan099.droidlink.display (Droid Link Display)"
        elif "${DROIDLINK_ADB}" -s "${dev}" shell pm list packages 2>/dev/null | grep -q "com.moreland.display"; then
            echo "Display App: com.moreland.display (Legacy Moreland Display)"
        else
            echo "Display App: None detected (expected io.github.rayhan099.droidlink.display)"
        fi
    else
        echo "Device: No single authorized target detected. Run 'tablet devices' to inspect."
    fi
    echo ""
    echo "=== Touch & Stylus Input ==="
    if is_input_active "${dev:-${TARGET_DEVICE:-}}"; then
        echo "Input driver: ACTIVE (uinput touch/stylus mapped to Wayland)"
    else
        log_file="$(get_input_log_file "${dev}")"
        if [[ ! -w "/dev/uinput" ]] && [[ ! -w "/dev/input/uinput" ]]; then
            echo "Input driver: INACTIVE (/dev/uinput restricted — run 'sudo ./scripts/setup-uinput.sh')"
        elif [[ -f "${log_file}" ]]; then
            last_err="$(grep -m 1 "^Error:" "${log_file}" 2>/dev/null || true)"
            if [[ -n "${last_err}" ]]; then
                echo "Input driver: INACTIVE (${last_err})"
            else
                echo "Input driver: INACTIVE"
            fi
        else
            echo "Input driver: INACTIVE"
        fi
    fi

    echo ""
    if [[ -n "${TABLET_AUDIO}" && -x "${TABLET_AUDIO}" ]]; then
        device_flag=()
        if [[ -n "${TARGET_DEVICE}" ]]; then
            device_flag=("--device" "${TARGET_DEVICE}")
        fi
        "${TABLET_AUDIO}" "${device_flag[@]}" status
    else
        echo "Tablet audio helper not found."
    fi
    ;;

  restart)
    systemctl --user restart moreland.service
    ;;

  doctor)
    echo "========================================================"
    echo "         DROIDLINK SYSTEM DIAGNOSTICS & AUDIT           "
    echo "========================================================"
    echo ""
    # 1. Host & OS
    echo "─── [1/6] Host & Linux Environment ───"
    echo "Kernel:      $(uname -s) $(uname -r) ($(uname -m))"
    if [[ -f /etc/os-release ]]; then
        os_name="$(grep -E "^PRETTY_NAME=" /etc/os-release | cut -d= -f2 | tr -d '"')"
        echo "OS:          ${os_name}"
    fi
    if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || command -v hyprctl >/dev/null 2>&1; then
        echo "Compositor:  Hyprland (ACTIVE: ${HYPRLAND_INSTANCE_SIGNATURE:-detected})"
        if command -v hyprctl >/dev/null 2>&1; then
            echo "Monitors:"
            hyprctl monitors 2>/dev/null | grep -E "Monitor |^[0-9]+x[0-9]+@" | sed 's/^/  /' || true
        fi
    else
        echo "Compositor:  Non-Hyprland Wayland or X11 session"
    fi
    echo ""

    # 2. Hardware Video Acceleration (VA-API)
    echo "─── [2/6] Video Acceleration & VA-API ───"
    if [[ -e /dev/dri/renderD128 ]]; then
        echo "DRM Render:  /dev/dri/renderD128 (EXISTS)"
    else
        echo "DRM Render:  [!] /dev/dri/renderD128 not found"
    fi
    if gst-inspect-1.0 vah264enc >/dev/null 2>&1; then
        echo "GStreamer:   vah264enc (AVAILABLE, hardware H.264 encoder verified)"
    else
        echo "GStreamer:   [!] vah264enc not found (install gst-plugin-va)"
    fi
    if gst-inspect-1.0 vapostproc >/dev/null 2>&1; then
        echo "Postproc:    vapostproc (AVAILABLE, DMA-BUF color conversion verified)"
    else
        echo "Postproc:    [!] vapostproc not found"
    fi
    echo ""

    # 3. Audio Subsystem (PipeWire)
    echo "─── [3/6] Audio & PipeWire Subsystem ───"
    if command -v pactl >/dev/null 2>&1; then
        pw_server="$(pactl info 2>/dev/null | grep -E "^Server Name:" | cut -d: -f2- | xargs || true)"
        pw_sink="$(pactl info 2>/dev/null | grep -E "^Default Sink:" | cut -d: -f2- | xargs || true)"
        echo "Audio Server: ${pw_server:-Detected}"
        echo "Default Sink: ${pw_sink:-Unknown}"
        echo "Loaded Modules:"
        pactl list modules short 2>/dev/null | grep -E "Tablet_Audio|simple-protocol" | sed 's/^/  /' || echo "  (None active)"
    else
        echo "Audio Server: [!] pactl command not found (install pulseaudio-utils)"
    fi
    echo ""

    # 4. Input & uinput
    echo "─── [4/6] Wayland Touch & Stylus (/dev/uinput) ───"
    if [[ -w "/dev/uinput" ]]; then
        echo "Uinput:      /dev/uinput is WRITABLE by current user (Non-root input ready)"
    else
        echo "Uinput:      [!] /dev/uinput is RESTRICTED (Run 'sudo ./scripts/setup-uinput.sh' to fix)"
    fi
    if [[ -f "/etc/udev/rules.d/99-droidlink-uinput.rules" ]]; then
        echo "Udev Rule:   /etc/udev/rules.d/99-droidlink-uinput.rules (INSTALLED)"
    else
        echo "Udev Rule:   /etc/udev/rules.d/99-droidlink-uinput.rules (Not installed)"
    fi
    if is_input_active; then
        echo "Input State: ACTIVE (droidlink-input running)"
    else
        echo "Input State: INACTIVE"
    fi
    echo ""

    # 5. Connected Android Devices & APKs
    echo "─── [5/6] Android ADB & Companion Apps ───"
    if command -v "${DROIDLINK_ADB}" >/dev/null 2>&1; then
        echo "ADB:         ${DROIDLINK_ADB}"
        dev_list="$(droidlink_list_devices)"
        if [[ -n "${dev_list}" ]]; then
            echo "Devices:"
            echo "${dev_list}" | sed 's/^/  /'
        else
            echo "Devices:     [!] No Android devices connected via USB."
        fi

        dev="$(droidlink_resolve_device "${TARGET_DEVICE}" 2>/dev/null || echo "")"
        if [[ -n "${dev}" ]]; then
            echo "Target:      ${dev}"
            d_app="Not Installed"
            if "${DROIDLINK_ADB}" -s "${dev}" shell pm list packages 2>/dev/null | grep -q "io.github.rayhan099.droidlink.display"; then
                d_app="io.github.rayhan099.droidlink.display (First-party Droid Link Display)"
            elif "${DROIDLINK_ADB}" -s "${dev}" shell pm list packages 2>/dev/null | grep -q "com.moreland.display"; then
                d_app="com.moreland.display (Legacy Moreland Display)"
            fi
            echo "Display App: ${d_app}"

            a_app="Not Installed"
            if "${DROIDLINK_ADB}" -s "${dev}" shell pm list packages 2>/dev/null | grep -q "io.github.rayhan099.droidlink.audio"; then
                a_app="io.github.rayhan099.droidlink.audio (First-party Droid Link Audio)"
            elif "${DROIDLINK_ADB}" -s "${dev}" shell pm list packages 2>/dev/null | grep -q "com.kaytat.simpleprotocolplayer"; then
                a_app="com.kaytat.simpleprotocolplayer (Legacy Simple Protocol Player)"
            fi
            echo "Audio App:   ${a_app}"
        fi
    else
        echo "ADB:         [!] adb not found"
    fi
    echo ""

    # 6. Network Ports & Reverse Tunnels
    echo "─── [6/6] TCP Port Bindings & Tunnels ───"
    if command -v ss >/dev/null 2>&1; then
        echo "Active Listening Ports:"
        ss -tlnp 2>/dev/null | grep -E "4711|4820|27183" | sed 's/^/  /' || echo "  (None active)"
    fi
    echo ""
    echo "========================================================"
    echo "               DIAGNOSTIC REPORT COMPLETE               "
    echo "========================================================"
    ;;

  *)
    echo "Usage: tablet [--device SERIAL] [start|stop|status|devices|doctor|restart|input [start|stop|status]|audio [start|stop|status]]" >&2
    exit 1
    ;;
esac
